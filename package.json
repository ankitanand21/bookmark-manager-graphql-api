{
  "name": "bookmark-manager-graphql-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "gendb": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "sanity": "bun run lint && bun run test"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.0.25",
    "@prisma/client": "^6.19.0",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.16.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.15.0",
    "prisma": "^6.19.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
